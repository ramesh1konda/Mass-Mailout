# Copy to .env.local and fill in. Never commit .env.local.
GEMINI_API_KEY=

# Mail server (npm run server). Leave SEND_ENABLED=false for a dry run.
SEND_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
# For Gmail/Workspace use an App Password, not your normal password
SMTP_PASS=
MAIL_FROM="Your Name <you@example.com>"
# Minimum milliseconds between sends
SEND_DELAY_MS=1000
MAIL_SERVER_PORT=3001
# Where dry runs save .eml previews
DRY_RUN_DIR=dry-run-output
# Where Admin templates are stored
TEMPLATES_FILE=data/templates.json

# CORE (ARMNet) connector: save each sent email (.eml) to the loan's documents via dbo.sp_PublishSSRSDocs.
# Off unless CORE_ATTACH_ENABLED=true.
CORE_ATTACH_ENABLED=false
CORE_DB_SERVER=
CORE_DB_NAME=
# windows = integrated security (needs ODBC Driver 17/18); sql = SQL login below
CORE_DB_AUTH=windows
CORE_DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
CORE_DB_USER=
CORE_DB_PASSWORD=
CORE_DB_ENCRYPT=true
CORE_DB_TRUST_CERT=true
# Nothing is written while this is true; the log and History show what would be saved
CORE_DB_DRYRUN=true
# Also save dry-run emails (UAT testing only)
CORE_ATTACH_DRYRUNS=false
# Server/database names containing "prod" are refused unless this is true
CORE_ALLOW_PROD=false
CORE_PUBLISH_PROC=dbo.sp_PublishSSRSDocs
# Loan GUID (@ownerGUID) comes from this CSV column...
CORE_LOANGUID_COLUMN=LoanGUID
# ...or, if the CSV has none, from this lookup (takes @LoanID, returns the GUID in the first column)
CORE_LOANID_COLUMN=Loanid
CORE_LOANGUID_LOOKUP_SQL=
# Document name = this + " dd-MM-yyyy HHmmss.eml"
CORE_DOC_TITLE={{Loanid}} - {{Clientname}}
# Defaults to DOMAIN\username of whoever runs the mail server
CORE_CREATED_BY=
