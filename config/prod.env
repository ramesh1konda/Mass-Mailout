# AIT-TBC | prod.env | Ramesh Konda | 2026-10-28 | Production settings (branch master)
# Change log:
#   2026-10-28 RK AIT-TBC Initial version
#
# Non-secret settings for PRODUCTION. Loaded when APP_ENV=prod (the pipeline sets it from the branch).
# Precedence: real environment variables > .env.local > this file.
# NEVER put secrets here (SMTP_USER/SMTP_PASS, CORE_DB_USER/CORE_DB_PASSWORD, GEMINI_API_KEY):
# they go in .env.local on the server or in an Azure DevOps secret variable group.

# Go-live checklist: fill in the TBC values, then set SEND_ENABLED=true, CORE_ATTACH_ENABLED=true
# and CORE_DB_DRYRUN=false in a reviewed commit to master.

# --- Mail ---
SEND_ENABLED=false
# Empty = any recipient (production)
SEND_ALLOWLIST=
SEND_DELAY_MS=1000
# TBC: production sender, e.g. Mass Mailout <noreply@amal.com.au>
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
DRY_RUN_DIR=dry-run-output
TEMPLATES_FILE=data/templates.json

# --- CORE ---
CORE_ATTACH_ENABLED=false
# TBC: production SQL Server and ARMNet database (e.g. ARMNet_Prod03)
CORE_DB_SERVER=
CORE_DB_NAME=
CORE_DB_AUTH=windows
CORE_DB_DRYRUN=true
CORE_ATTACH_DRYRUNS=false
# Production databases are allowed only here (APP_ENV=prod)
CORE_ALLOW_PROD=true
