# AIT-TBC | dev.env | Ramesh Konda | 2026-10-28 | Development settings (branch dev)
# Change log:
#   2026-10-28 RK AIT-TBC Initial version
#
# Non-secret settings for DEV. Loaded when APP_ENV=dev (the pipeline sets it from the branch).
# Precedence: real environment variables > .env.local > this file.
# NEVER put secrets here (SMTP_USER/SMTP_PASS, CORE_DB_USER/CORE_DB_PASSWORD, GEMINI_API_KEY):
# they go in .env.local on the server or in an Azure DevOps secret variable group.

# --- Mail ---
SEND_ENABLED=false
# Live sends in dev may only go to these addresses/domains (required when SEND_ENABLED=true)
SEND_ALLOWLIST=@iqeq.com,@amal.com.au
SEND_DELAY_MS=1000
# TBC: dev sender, e.g. Mass Mailout DEV <noreply-dev@amal.com.au>
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
DRY_RUN_DIR=dry-run-output
TEMPLATES_FILE=data/templates.json

# --- CORE ---
CORE_ATTACH_ENABLED=false
# TBC: dev SQL Server and ARMNet database
CORE_DB_SERVER=
CORE_DB_NAME=
CORE_DB_AUTH=windows
CORE_DB_DRYRUN=true
CORE_ATTACH_DRYRUNS=false
CORE_ALLOW_PROD=false
